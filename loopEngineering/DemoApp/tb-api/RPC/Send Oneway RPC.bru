meta {
  name: Send Oneway RPC
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/rpc/oneway/{{deviceId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Authorization: Bearer {{accessToken}}
  Accept: application/json
}

body:json {
  {
    "method": "setValue",
    "params": {
      "value": true
    },
    "timeout": 5000
  }
}
