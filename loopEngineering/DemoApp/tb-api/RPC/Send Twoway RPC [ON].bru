meta {
  name: Send Twoway RPC [ON]
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/rpc/twoway/{{deviceId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Authorization: Bearer {{accessToken}}
  Accept: application/json
}

body:json {
  {
    "method": "getValue",
    "params": {},
    "timeout": 5000
  }
}
